{
  "name": "straschek-io/typo3-hyphenator",
  "description": "Provides soft-hyphen replacement for TYPO3",
  "license": "GPL-2.0-or-later",
  "support": {
    "email": "hallo@straschek.io",
    "source": "https://github.com/straschek-io/typo3-hyphenator",
    "issues": "https://github.com/straschek-io/typo3-hyphenator/issues"
  },
  "authors": [
    {
      "name": "Michael Straschek",
      "email": "hallo@straschek.io"
    }
  ],
  "type": "typo3-cms-extension",
  "require": {
    "typo3/cms-core": "^12.4 | ^13.4"
  },
  "autoload": {
    "psr-4": {
      "StraschekIo\\Hyphenator\\": "Classes/"
    }
  },
  "autoload-dev": {
    "psr-4": {
      "StraschekIo\\Hyphenator\\Tests\\": "Tests/"
    }
  },
  "require-dev": {
    "friendsofphp/php-cs-fixer": "^3.75",
    "phpunit/phpunit": "^10.5"
  },
  "scripts": {
    "cs": "php-cs-fixer fix --dry-run --diff",
    "test": "phpunit"
  },
  "config": {
    "allow-plugins": {
      "typo3/class-alias-loader": true,
      "typo3/cms-composer-installers": true
    }
  },
  "extra": {
    "typo3/cms": {
      "extension-key": "typo3_hyphenator"
    }
  }
}
